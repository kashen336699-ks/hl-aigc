# PostgreSQL 连接串
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hl_aigc

# better-auth 签名密钥，至少 32 个字符（可用 `openssl rand -base64 32` 生成）
BETTER_AUTH_SECRET=change-me-to-a-random-secret-of-32-chars

# 服务端对外地址（better-auth baseURL），生产环境必须为 HTTPS
BETTER_AUTH_URL=http://localhost:3000

# 允许的前端来源（CORS + better-auth trustedOrigins），生产环境必须为 HTTPS
CORS_ORIGIN=http://localhost:3001

# 服务端监听端口（可选，默认 3000）
PORT=3000

# 运行环境: development | production | test（可选，默认 development）
NODE_ENV=development
